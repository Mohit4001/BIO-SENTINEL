<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>BioSENTINEL Digital Twin</title>
<style>
:root{--bg:#071018;--panel:#0d1923;--panel2:#102331;--text:#e9f4f7;--muted:#8ba7b3;--line:#1d3a48;--accent:#4dd0c8;--warn:#ffd166;--danger:#ff6b6b;--good:#54d18a}*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 20% 0,#123242 0,#071018 42%);color:var(--text);font:14px/1.45 Inter,system-ui,sans-serif}.wrap{max-width:1500px;margin:auto;padding:20px}.header{display:flex;justify-content:space-between;align-items:center;gap:20px;border-bottom:1px solid var(--line);padding-bottom:16px}.brand{font-size:26px;font-weight:800;letter-spacing:.12em}.brand span{color:var(--accent)}.subtitle{color:var(--muted)}.sim{padding:6px 10px;border:1px solid #805f20;color:#ffd166;background:#3b2b0c;border-radius:20px;font-weight:800;font-size:11px}.grid{display:grid;grid-template-columns:1.3fr 1fr 1fr;gap:14px;margin-top:14px}.panel{background:linear-gradient(180deg,#0e1d28,#0a151e);border:1px solid var(--line);border-radius:14px;padding:16px;box-shadow:0 8px 30px #0004}.wide{grid-column:1/-1}.title{font-size:12px;text-transform:uppercase;letter-spacing:.12em;color:var(--muted);margin-bottom:12px}.risk{display:flex;align-items:center;gap:18px}.score{font-size:54px;font-weight:800;line-height:1}.level{font-size:22px;font-weight:800}.bar{height:12px;background:#172a35;border-radius:10px;overflow:hidden;margin:12px 0}.bar i{display:block;height:100%;width:0;background:var(--accent);transition:.35s}.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.metric{background:#0a1821;border:1px solid var(--line);padding:12px;border-radius:10px}.metric b{display:block;font-size:23px}.metric small{color:var(--muted)}.controls{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.ctrl label{display:flex;justify-content:space-between;color:var(--muted)}input[type=range]{width:100%;accent-color:var(--accent)}button{border:1px solid var(--line);background:#112632;color:var(--text);padding:10px;border-radius:9px;cursor:pointer;font-weight:700}button:hover{border-color:var(--accent)}.scenarios{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.scenario{font-size:12px}.status{display:flex;gap:8px;flex-wrap:wrap}.pill{padding:6px 9px;border-radius:999px;background:#102731;border:1px solid var(--line);font-weight:700}.pill.on{border-color:var(--good);color:var(--good)}.pill.off{border-color:var(--danger);color:var(--danger)}.pipeline{display:grid;grid-template-columns:repeat(8,1fr);gap:4px;align-items:center}.stage{padding:10px 4px;text-align:center;border:1px solid var(--line);background:#0b1821;border-radius:8px;font-size:10px;color:var(--muted)}.stage.active{color:var(--accent);border-color:var(--accent);box-shadow:0 0 15px #4dd0c833}.arrow{text-align:center;color:#527381}.charts{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.chart{height:150px;background:#07121a;border:1px solid var(--line);border-radius:10px;padding:8px}.chart canvas{width:100%;height:100%}.log{height:220px;overflow:auto;background:#050d12;padding:10px;border-radius:10px;font:12px ui-monospace,monospace;color:#9fc3cd}.action{font-size:18px;font-weight:800}.advice{color:#c7d9df}.privacy{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap}.oled{font-family:monospace;background:#021016;border:5px solid #1b3d43;border-radius:8px;padding:16px;min-height:150px;color:#b8fff3;white-space:pre-line}.sos{display:none;background:#45141a;border:1px solid #ff6b6b}.sos.show{display:block}.sos button{margin-right:8px}.foot{margin-top:14px;color:#6f8d98;font-size:12px}@media(max-width:1000px){.grid{grid-template-columns:1fr}.wide{grid-column:auto}.metrics,.charts{grid-template-columns:repeat(2,1fr)}.pipeline{grid-template-columns:repeat(4,1fr)}.controls,.scenarios{grid-template-columns:repeat(2,1fr)}}
</style></head><body><div class="wrap">
<header class="header"><div><div class="brand">BIO<span>SENTINEL</span></div><div class="subtitle">AI-Powered Personal Health & Disaster-Resilience Companion · Digital Twin</div></div><div class="sim">SIMULATION — NOT MEDICAL MEASUREMENT</div></header>
<div class="grid">
<section class="panel"><div class="title">Personal risk engine</div><div class="risk"><div><div class="score" id="score">12</div><div class="level" id="level">LOW</div></div><div style="flex:1"><div class="bar"><i id="bar"></i></div><div class="advice" id="action">CONTINUE MONITORING</div></div></div><div class="status" style="margin-top:14px"><span class="pill on" id="ai">● ON-DEVICE AI ACTIVE</span><span class="pill on" id="local">● LOCAL PROCESSING</span><span class="pill" id="conn">● BLE ONLINE</span></div></section>
<section class="panel"><div class="title">Context engine</div><div style="font-size:25px;font-weight:800" id="context">NORMAL DAY</div><p class="advice" id="contextText">Baseline-aware monitoring with no disaster context.</p></section>
<section class="panel"><div class="title">Privacy</div><div class="privacy"><span>DATA PROCESSING</span><b>LOCAL / ON DEVICE</b><span>RAW HEALTH DATA</span><b>NOT SENT TO CLOUD</b><span>SHARING</span><b id="sharing">ENABLED</b></div></section>
<section class="panel wide"><div class="title">Physiological + environmental telemetry</div><div class="metrics"><div class="metric"><small>HR</small><b id="hr">72</b><span>BPM · SIMULATION</span></div><div class="metric"><small>SpO₂</small><b id="spo2">98</b><span>% · SIMULATION</span></div><div class="metric"><small>BODY TEMP</small><b id="temp">36.7</b><span>°C · SIMULATION</span></div><div class="metric"><small>ACTIVITY</small><b id="activity">35</b><span>% · SIMULATION</span></div><div class="metric"><small>HUMIDITY</small><b id="hum">50</b><span>% · SIMULATION</span></div><div class="metric"><small>CO₂</small><b id="co2">850</b><span>ppm · SIMULATION</span></div><div class="metric"><small>PM2.5</small><b id="pm">12</b><span>µg/m³ · SIMULATION</span></div><div class="metric"><small>FALL</small><b id="fall">NONE</b><span>IMU · SIMULATION</span></div></div></section>
<section class="panel"><div class="title">Simulated sensor controls</div><div class="controls"><div class="ctrl"><label>Heart rate <b id="hrv">72</b></label><input id="hrIn" type="range" min="45" max="150" value="72"></div><div class="ctrl"><label>SpO₂ <b id="spv">98</b></label><input id="spIn" type="range" min="88" max="100" value="98"></div><div class="ctrl"><label>Body temp <b id="tv">36.7</b></label><input id="tIn" type="range" min="35.5" max="41" step="0.1" value="36.7"></div><div class="ctrl"><label>Activity <b id="av">35</b></label><input id="aIn" type="range" min="0" max="100" value="35"></div><div class="ctrl"><label>Humidity <b id="hv">50</b></label><input id="hIn" type="range" min="10" max="100" value="50"></div><div class="ctrl"><label>PM2.5 <b id="pv">12</b></label><input id="pIn" type="range" min="0" max="250" value="12"></div></div></section>
<section class="panel"><div class="title">Scenario controls</div><div class="scenarios"><button class="scenario" data-s="normal">NORMAL</button><button class="scenario" data-s="heat">HEAT WAVE</button><button class="scenario" data-s="pollution">AIR POLLUTION</button><button class="scenario" data-s="flood">FLOOD</button><button class="scenario" data-s="cyclone">CYCLONE</button><button class="scenario" data-s="fall">FALL</button><button class="scenario" data-s="critical">CRITICAL</button><button class="scenario" data-s="offline">CONNECTIVITY LOSS</button><button class="scenario" data-s="reset">RESET</button></div></section>
<section class="panel"><div class="title">Simulated OLED</div><div class="oled" id="oled"></div></section>
<section class="panel"><div class="title">Action / response</div><div class="action" id="action2">CONTINUE MONITORING</div><p class="advice" id="advice">Continue local monitoring.</p><div class="status"><span class="pill" id="haptic">HAPTIC: OFF</span><span class="pill" id="buzzer">BUZZER: OFF</span><span class="pill" id="gps">GPS: READY / PERMISSIONED</span></div></section>
<section class="panel wide"><div class="title">Processing pipeline</div><div class="pipeline" id="pipeline"><div class="stage active">RAW</div><div class="arrow">→</div><div class="stage">FILTER</div><div class="arrow">→</div><div class="stage">FEATURES</div><div class="arrow">→</div><div class="stage">BASELINE</div><div class="arrow">→</div><div class="stage">FUSION</div><div class="arrow">→</div><div class="stage">TINYML</div><div class="arrow">→</div><div class="stage">RISK</div><div class="arrow">→</div><div class="stage">ACTION</div></div></section>
<section class="panel wide"><div class="title">Trends — SIMULATION</div><div class="charts"><div class="chart"><canvas id="cHR"></canvas></div><div class="chart"><canvas id="cSp"></canvas></div><div class="chart"><canvas id="cTemp"></canvas></div><div class="chart"><canvas id="cRisk"></canvas></div></div></section>
<section class="panel wide"><div class="title">Engineering log</div><div class="log" id="log"></div></section>
<section class="panel wide sos" id="sos"><div class="title">SOS STATE MACHINE</div><div style="font-size:28px;font-weight:900" id="count">10</div><p>Possible critical event detected. This is a simulation. Confirm/cancel to demonstrate the state transition.</p><button id="cancel">CANCEL</button><button id="confirm">CONFIRM SOS</button><b id="sosState"></b></section>
</div><div class="foot">Prototype only. No clinical validation. Risk thresholds are demonstration thresholds. No real patient data is used.</div></div>
<script>
const $=id=>document.getElementById(id); const hist={hr:[],sp:[],temp:[],risk:[]}; let state={hr:72,spo2:98,temp:36.7,activity:.35,hum:50,pm:12,co2:850,context:'NORMAL DAY',offline:false,fall:false}; let baseline={hr:72,spo2:98,temp:36.7}; let countdown=null;
const scenarios={normal:[72,98,36.7,.35,50,12,'NORMAL DAY'],heat:[104,97,39.6,.85,78,20,'HEAT WAVE'],pollution:[94,93.5,37.1,.55,65,175,'AIR POLLUTION'],flood:[88,97,37.2,.25,90,45,'FLOOD'],cyclone:[91,97,37.1,.2,92,55,'CYCLONE'],fall:[76,98,36.8,.05,50,12,'FALL'],critical:[125,90,40.2,.85,82,180,'CRITICAL'],offline:[72,98,36.7,.35,50,12,'OFFLINE MODE']};
function clamp(x,a=0,b=1){return Math.max(a,Math.min(b,x))} function calc(){let hrDev=clamp(Math.abs(state.hr-baseline.hr)/45),spDev=clamp((baseline.spo2-state.spo2)/8),tDev=clamp(Math.abs(state.temp-baseline.temp)/3.5);let heat=clamp((state.temp-37.5)/3*.55+(state.hum-60)/40*.25+state.activity*.2);let cardio=clamp(hrDev*.65+spDev*.35);let env=clamp(state.pm/200*.75+(state.co2-500)/2500*.25);let fatigue=clamp(hrDev*.35+tDev*.25+state.activity*.4);let base=clamp(hrDev*.35+spDev*.3+tDev*.35);let context=state.context==='HEAT WAVE'?.2:state.context==='AIR POLLUTION'?.18:['FLOOD','CYCLONE'].includes(state.context)?.08:state.context==='CRITICAL'?.3:0;let z=-2.4+1.65*cardio+1.25*heat+1.35*env+1.1*base+.9*fatigue+context+(state.fall?1.8:0);let prob=1/(1+Math.exp(-z));let score=Math.round(prob*100);if(state.fall)score=Math.max(score,78);let level=score<25?'LOW':score<50?'MODERATE':score<75?'HIGH':'CRITICAL';return{score,level,cardio,heat,env,fatigue,base,prob}}
function setScenario(s){if(s==='reset')s='normal';let x=scenarios[s];state={hr:x[0],spo2:x[1],temp:x[2],activity:x[3],hum:x[4],pm:x[5],co2:Math.round(450+x[4]*8),context:x[6],offline:s==='offline',fall:s==='fall'}; sync(); log('SCENARIO',`${state.context} | simulated inputs loaded`)}
function sync(){ $('hrIn').value=state.hr;$('spIn').value=state.spo2;$('tIn').value=state.temp;$('aIn').value=state.activity*100;$('hIn').value=state.hum;$('pIn').value=state.pm;render() }
function render(){let r=calc();$('score').textContent=r.score;$('level').textContent=r.level;$('bar').style.width=r.score+'%';$('hr').textContent=Math.round(state.hr);$('spo2').textContent=state.spo2.toFixed(1);$('temp').textContent=state.temp.toFixed(1);$('activity').textContent=Math.round(state.activity*100);$('hum').textContent=Math.round(state.hum);$('co2').textContent=Math.round(state.co2);$('pm').textContent=Math.round(state.pm);$('fall').textContent=state.fall?'DETECTED':'NONE';$('context').textContent=state.context;$('conn').textContent=state.offline?'● OFFLINE':'● BLE ONLINE';$('conn').className='pill '+(state.offline?'off':'on');let action=r.level==='LOW'?'CONTINUE MONITORING':r.level==='MODERATE'?'REST / HYDRATE':r.level==='HIGH'?'LOCAL ALERT':'SOS / ASSISTANCE';$('action').textContent=action;$('action2').textContent=action;$('advice').textContent=state.context==='HEAT WAVE'?'High environmental heat detected. Reduce exertion and hydrate.':state.context==='AIR POLLUTION'?'High PM2.5 context. Reduce exposure and monitor trend.':state.fall?'Fall pattern detected. Verify safety and use SOS flow if needed.':r.level==='CRITICAL'?'Critical demonstration state. Follow SOS flow.':'Continue local monitoring.';$('contextText').textContent=state.context==='HEAT WAVE'?'Heat + humidity + activity modify contextual risk.':state.context==='AIR POLLUTION'?'PM2.5 + physiological trend modify contextual risk.':'Context is an advisory modifier, not a diagnosis.';$('haptic').textContent='HAPTIC: '+(r.score>=50?'ACTIVE':'OFF');$('buzzer').textContent='BUZZER: '+(r.score>=50?'ACTIVE':'OFF');$('oled').textContent=`BIO SENTINEL\nSIMULATION | LOCAL AI\nHR ${Math.round(state.hr)}  SpO2 ${state.spo2.toFixed(1)}%\nTEMP ${state.temp.toFixed(1)}C ACT ${Math.round(state.activity*100)}%\nRISK ${String(r.score).padStart(3,'0')} ${r.level}\n${state.context}\n${state.offline?'OFFLINE MODE':'NETWORK OPTIONAL'}${state.fall?'\nFALL DETECTED':''}`;hist.hr.push(state.hr);hist.sp.push(state.spo2);hist.temp.push(state.temp);hist.risk.push(r.score);for(const k in hist)if(hist[k].length>60)hist[k].shift();draw('cHR',hist.hr,45,150);draw('cSp',hist.sp,88,100);draw('cTemp',hist.temp,35,42);draw('cRisk',hist.risk,0,100);pipeline(r);if(state.fall||r.score>=75)openSOS();}
function pipeline(r){let active=Math.floor((Date.now()/500)%8);document.querySelectorAll('.stage').forEach((e,i)=>{e.classList.toggle('active',i===active)});}
function draw(id,data,min,max){let c=$(id),x=c.getContext('2d'),w=c.clientWidth*devicePixelRatio,h=c.clientHeight*devicePixelRatio;c.width=w;c.height=h;x.clearRect(0,0,w,h);x.strokeStyle='#1d3a48';x.lineWidth=1;for(let i=1;i<4;i++){x.beginPath();x.moveTo(0,h*i/4);x.lineTo(w,h*i/4);x.stroke()}if(data.length<2)return;x.strokeStyle='#4dd0c8';x.lineWidth=2;x.beginPath();data.forEach((v,i)=>{let px=i*w/(data.length-1),py=h-(v-min)/(max-min)*h;i?x.lineTo(px,py):x.moveTo(px,py)});x.stroke()}
function log(k,v){let t=new Date().toLocaleTimeString();$('log').innerHTML=`<div>${t} | ${k.padEnd(10)} | ${v}</div>`+$('log').innerHTML}
['hrIn','spIn','tIn','aIn','hIn','pIn'].forEach(id=>$(id).addEventListener('input',()=>{state.hr=+$('hrIn').value;state.spo2=+$('spIn').value;state.temp=+$('tIn').value;state.activity=+$('aIn').value/100;state.hum=+$('hIn').value;state.pm=+$('pIn').value;state.co2=450+state.hum*8;$('hrv').textContent=Math.round(state.hr);$('spv').textContent=state.spo2;$('tv').textContent=state.temp;$('av').textContent=Math.round(state.activity*100);$('hv').textContent=Math.round(state.hum);$('pv').textContent=Math.round(state.pm);render()}));
document.querySelectorAll('[data-s]').forEach(b=>b.onclick=()=>setScenario(b.dataset.s));$('cancel').onclick=()=>{clearInterval(countdown);$('sos').classList.remove('show');$('sosState').textContent='FALSE ALARM — RESUME MONITORING';state.fall=false;render();log('SOS','cancelled / false alarm')};$('confirm').onclick=()=>{clearInterval(countdown);$('count').textContent='ALERT SENT';$('sosState').textContent='SOS + GPS | communication channel available / permissioned';log('SOS','confirmed; simulated GPS alert state')};function openSOS(){if($('sos').classList.contains('show'))return;$('sos').classList.add('show');let n=10;$('count').textContent=n;countdown=setInterval(()=>{n--;if(n<=0){clearInterval(countdown);$('count').textContent='NO RESPONSE → ALERT SENT';$('sosState').textContent='SOS + GPS | simulated transmission';log('SOS','no response; simulated alert sent')}else $('count').textContent=n},1000)}
setInterval(()=>render(),1200);setScenario('normal');log('BOOT','BioSENTINEL digital twin started | SIMULATION');
</script></body></html>
